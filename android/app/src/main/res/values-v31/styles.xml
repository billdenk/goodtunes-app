<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Android 12+ launch theme. The OS draws its own SplashScreen here, so
         we hand it the brand navy background and the centered "G" mark via the
         native windowSplashScreen* attributes (these only exist from API 31,
         hence the values-v31 qualifier). This replaces the legacy stretched
         full-screen splash.png the OS used to override, eliminating the brief
         white flash before the Capacitor splash (#00062B). Behavior now
         matches the pre-12 layer-list in values/styles.xml. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
