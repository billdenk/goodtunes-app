# Git LFS — large binary media that the web/iOS build NEVER imports.
#
# WHY scoped to attached_assets/ and limited to these extensions:
#   * The web build (`npm run build`, also run on every Codemagic checkout)
#     imports specific IMAGES from attached_assets/ via the `@assets/...` alias
#     (see client/src/data/musicData.ts etc.). Those files MUST stay as normal
#     in-tree git blobs.
#   * The GitHub build mirror (github.com/billdenk/goodtunes-app) is pushed with
#     GIT_LFS_SKIP_PUSH=1, so it carries NO LFS objects — only tiny pointer blobs.
#     A build-imported file moved to LFS would resolve to a broken pointer at the
#     Codemagic checkout and fail the build.
#   * The iOS AppIcon.appiconset PNGs must likewise stay as normal in-tree files.
#
# => NEVER add image globs (*.png / *.jpg / *.jpeg / *.webp / *.svg) here.
# Only video / screen-recording / audio / archive media — which the build does
# not import — is safe to route to LFS so it stops bloating git history.
attached_assets/**/*.[Mm][Pp]4 filter=lfs diff=lfs merge=lfs -text
attached_assets/**/*.[Mm][Oo][Vv] filter=lfs diff=lfs merge=lfs -text
attached_assets/**/*.[Mm]4[Vv] filter=lfs diff=lfs merge=lfs -text
attached_assets/**/*.[Ww][Ee][Bb][Mm] filter=lfs diff=lfs merge=lfs -text
attached_assets/**/*.[Aa][Vv][Ii] filter=lfs diff=lfs merge=lfs -text
attached_assets/**/*.[Mm][Kk][Vv] filter=lfs diff=lfs merge=lfs -text
attached_assets/**/*.[Ww][Aa][Vv] filter=lfs diff=lfs merge=lfs -text
attached_assets/**/*.[Aa][Ii][Ff][Ff] filter=lfs diff=lfs merge=lfs -text
attached_assets/**/*.[Ff][Ll][Aa][Cc] filter=lfs diff=lfs merge=lfs -text
attached_assets/**/*.[Zz][Ii][Pp] filter=lfs diff=lfs merge=lfs -text
attached_assets/**/*.[Gg][Zz] filter=lfs diff=lfs merge=lfs -text
attached_assets/**/*.7[Zz] filter=lfs diff=lfs merge=lfs -text
attached_assets/**/*.[Tt][Aa][Rr] filter=lfs diff=lfs merge=lfs -text
