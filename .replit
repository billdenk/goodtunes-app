modules = ["nodejs-20", "web", "python-3.11", "postgresql-16"]
run = "npm run dev"
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

[nix]
channel = "stable-24_05"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 23636
externalPort = 3000

[env]
PORT = "5000"

[deployment]
deploymentTarget = "autoscale"
run = ["node", "./dist/index.cjs"]
build = ["npm", "run", "build"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "design-lint"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "db-query-smoke"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "schema-drift-smoke"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "app-icon-guards-smoke"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "ios-ipa-icon-smoke"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "codemagic-android-changeset-smoke"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[[workflows.workflow]]
name = "design-lint"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run design:lint"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "db-query-smoke"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "tsx scripts/db-query-smoke.ts"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "test"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "TSX_TSCONFIG_PATH=tsconfig.test.json npx tsx --test --test-force-exit $(find client shared server -name '*.test.ts' -not -path '*/node_modules/*')"

[[workflows.workflow]]
name = "schema-drift-smoke"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "tsx scripts/schema-drift-smoke.ts"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "app-icon-guards-smoke"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3 scripts/verify-app-icon-guards-smoke.py"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "ios-ipa-icon-smoke"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3 scripts/verify-ios-ipa-icon-smoke.py"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "codemagic-android-changeset-smoke"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3 scripts/verify-codemagic-android-changeset-smoke.py"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "FULLSTACK_JS"
integrations = ["javascript_object_storage:2.0.0", "javascript_openai_ai_integrations:2.0.0", "stripe:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 300000

[userenv]

[userenv.shared]
MAIL_FROM = "GoodTunes <invites@invites.goodtunes.music>"
OPS_ALERT_EMAIL = "bill@gogoods.com"
MAIL_REPLY_TO = "admin@goodtunes.music"
