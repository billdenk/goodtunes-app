<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Task #535 — Universal Links. Pairs with the
         apple-app-site-association file served at
         https://my.goodtunes.music/.well-known/apple-app-site-association.
         The operator-managed Apple Team ID prefix on the appIDs in that
         file must match this app's signing team for verification to
         succeed.
         We intentionally do NOT claim the bare goodtunes.music apex: that
         host is the Webflow marketing site (it can't serve our AASA file),
         so claiming it would only produce a permanent verification failure.
         Fan-shareable content links live on the app subdomains, not the
         marketing homepage. -->
    <key>com.apple.developer.associated-domains</key>
    <array>
        <string>applinks:my.goodtunes.music</string>
    </array>
    <!-- Task #535 — Push entitlement declared now so the binary asks
         Apple for the right provisioning, even though we don't send any
         payloads yet (that wiring is a follow-up task). Must be
         "production" for TestFlight / App Store distribution builds:
         Xcode does NOT auto-swap this value, and a "development" value is
         rejected at upload (ITMS-90163 invalid aps-environment). -->
    <key>aps-environment</key>
    <string>production</string>
    <!-- Task #2504 — CarPlay audio. Grants the app the CarPlay audio scene so
         a head unit can connect and show the now-playing + Up Next templates
         (CarPlaySceneDelegate). This is a MANAGED entitlement: Apple must
         approve the CarPlay-audio capability on the App ID before it can be
         signed for distribution — until then, device/simulator CarPlay testing
         works with a development profile but App Store builds will fail signing
         if the capability isn't enabled on the provisioning profile. -->
    <key>com.apple.developer.carplay-audio</key>
    <true/>
</dict>
</plist>
