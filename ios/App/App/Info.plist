<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
        <key>CFBundleDevelopmentRegion</key>
        <string>en</string>
        <key>CFBundleDisplayName</key>
        <string>GoodTunes</string>
        <key>CFBundleExecutable</key>
        <string>$(EXECUTABLE_NAME)</string>
        <key>CFBundleIdentifier</key>
        <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
        <key>CFBundleInfoDictionaryVersion</key>
        <string>6.0</string>
        <key>CFBundleName</key>
        <string>$(PRODUCT_NAME)</string>
        <key>CFBundlePackageType</key>
        <string>APPL</string>
        <key>CFBundleShortVersionString</key>
        <string>$(MARKETING_VERSION)</string>
        <key>CFBundleVersion</key>
        <string>$(CURRENT_PROJECT_VERSION)</string>
        <key>LSRequiresIPhoneOS</key>
        <true/>
        <key>UILaunchStoryboardName</key>
        <string>LaunchScreen</string>
        <key>UIMainStoryboardFile</key>
        <string>Main</string>
        <key>UIRequiredDeviceCapabilities</key>
        <array>
                <string>armv7</string>
        </array>
        <!-- Task #535: phone is portrait-only (mobile-first single column,
             max width ~440px — landscape is out of scope for v1). iPad
             keeps multi-orientation so reviewers don't reject it as a
             phone-only app submitted universal. -->
        <key>UISupportedInterfaceOrientations</key>
        <array>
                <string>UIInterfaceOrientationPortrait</string>
        </array>
        <key>UISupportedInterfaceOrientations~ipad</key>
        <array>
                <string>UIInterfaceOrientationPortrait</string>
                <string>UIInterfaceOrientationPortraitUpsideDown</string>
                <string>UIInterfaceOrientationLandscapeLeft</string>
                <string>UIInterfaceOrientationLandscapeRight</string>
        </array>
        <key>UIViewControllerBasedStatusBarAppearance</key>
        <true/>
        <!-- Background audio so playback continues with the screen off or
             when the user is in another app. Required for any music app. -->
        <key>UIBackgroundModes</key>
        <array>
                <string>audio</string>
        </array>
        <!-- Scene manifest: phone window + CarPlay (Tasks #2504 + #2570).
             Once a UIApplicationSceneManifest is present, UIKit adopts the
             scene lifecycle for the WHOLE app and ignores the legacy
             AppDelegate/UIMainStoryboardFile window path. The original CarPlay
             change declared ONLY the CarPlay role here, so the phone session
             had no window configuration and the App Store build launched to a
             BLACK screen (Task #2570). Fix: declare BOTH roles —
               * UIWindowSceneSessionRoleApplication → SceneDelegate + the Main
                 storyboard (initial VC = Capacitor's CAPBridgeViewController),
                 so the phone window hosts the same bridge as before;
               * CPTemplateApplicationSceneSessionRoleApplication →
                 CarPlaySceneDelegate for the in-car surface.
             UIApplicationSupportsMultipleScenes stays true so the phone and
             CarPlay scenes can run simultaneously (required for CarPlay
             audio). UISceneDelegateClassName is module-qualified because Swift
             classes live under the product module namespace. The CarPlay scene
             still pairs with the com.apple.developer.carplay-audio entitlement,
             which Apple must grant before a real head unit connects (Codemagic
             strips that entitlement from distribution archives until then —
             the manifest itself is safe to ship now that the window role is
             declared). -->
        <key>UIApplicationSceneManifest</key>
        <dict>
                <key>UIApplicationSupportsMultipleScenes</key>
                <true/>
                <key>UISceneConfigurations</key>
                <dict>
                        <key>UIWindowSceneSessionRoleApplication</key>
                        <array>
                                <dict>
                                        <key>UISceneConfigurationName</key>
                                        <string>Phone</string>
                                        <key>UISceneDelegateClassName</key>
                                        <string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
                                        <key>UISceneStoryboardFile</key>
                                        <string>Main</string>
                                </dict>
                        </array>
                        <key>CPTemplateApplicationSceneSessionRoleApplication</key>
                        <array>
                                <dict>
                                        <key>UISceneConfigurationName</key>
                                        <string>CarPlay</string>
                                        <key>UISceneDelegateClassName</key>
                                        <string>$(PRODUCT_MODULE_NAME).CarPlaySceneDelegate</string>
                                </dict>
                        </array>
                </dict>
        </dict>
        <!-- App Transport Security: all GoodTunes traffic is HTTPS to
             goodtunes.music + Mux/Stripe/Object Storage CDNs. No
             arbitrary loads allowed; this keeps App Review happy and
             prevents accidental cleartext fetches from sneaking in.

             NSPinnedDomains (iOS 14+) pins GoodTunes' OWN hosts so the
             native, TLS-pinned offline-download fetch (URLSession in
             SecureKeyStorePlugin.pinnedDownload) can't be MITM'd on a
             GoodTunes host. We pin the long-lived ISRG (Let's Encrypt)
             ROOTS — NOT the leaf/intermediate, which rotate every ~60 days
             and would brick installs — one primary + two backups:
               * ISRG Root X2  (ECDSA root both subdomains chain to today)
               * ISRG Root X1  (RSA root, R-series chain backup)
               * ISRG Root YE  (new ECDSA root get.goodtunes.music already uses)
             See docs/cert-pinning.md for the rotation runbook. Only
             goodtunes.music is pinned; other hosts (legacy Dropbox masters,
             Mux, Stripe) stay on normal validation so this can't brick them.
             NSPinnedDomains applies to URLSession, NOT WKWebView, so the
             WebView shell load is unaffected and the download is fetched via
             URLSession on purpose. Ignored on iOS 13 (defense-in-depth). -->
        <key>NSAppTransportSecurity</key>
        <dict>
                <key>NSAllowsArbitraryLoads</key>
                <false/>
                <key>NSPinnedDomains</key>
                <dict>
                        <key>goodtunes.music</key>
                        <dict>
                                <key>NSIncludesSubdomains</key>
                                <true/>
                                <key>NSPinnedCAIdentities</key>
                                <array>
                                        <dict>
                                                <key>SPKI-SHA256-BASE64</key>
                                                <string>diGVwiVYbubAI3RW4hB9xU8e/CH2GnkuvVFZE8zmgzI=</string>
                                        </dict>
                                        <dict>
                                                <key>SPKI-SHA256-BASE64</key>
                                                <string>C5+lpZ7tcVwmwQIMcRtPbsQtWLABXhQzejna0wHFr8M=</string>
                                        </dict>
                                        <dict>
                                                <key>SPKI-SHA256-BASE64</key>
                                                <string>sCkq5UWXjg+7mKu9lMhhYF5bGLsy7VI/UNW3tccdR7w=</string>
                                        </dict>
                                </array>
                        </dict>
                </dict>
        </dict>
        <!-- Export-compliance: GoodTunes uses only standard, exempt encryption
             (HTTPS/TLS to goodtunes.music + Mux/Stripe/Object Storage; no
             proprietary or non-standard crypto). Declaring this as false
             auto-answers Apple's encryption question so every uploaded build
             goes straight to TestFlight testers instead of being held in
             "Missing Compliance" (which also fails Codemagic's auto-distribute
             step). If a custom crypto algorithm is ever added, revisit this. -->
        <key>ITSAppUsesNonExemptEncryption</key>
        <false/>
        <!-- Intentionally NOT declaring NSUserTrackingUsageDescription:
             we don't use IDFA / cross-app tracking. Adding the key
             without using it is an App Review guideline 5.1.2 rejection
             trigger. Re-add only if a tracking SDK ships. -->
</dict>
</plist>
