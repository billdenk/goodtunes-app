    <script>
      (function () {
        try {
          var h = window.location.host.toLowerCase().split(":")[0];
          var p = window.location.pathname || "";
          var isAdmin = h === "admin.goodtunes.music" || p.indexOf("/admin") === 0;
          if (isAdmin) document.title = "GoodTunes Admin";
        } catch (e) {}
      })();
    </script>
